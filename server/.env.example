PORT=4000
# Matches docker-compose.yml. Change if you use your own PostgreSQL incase running on Supabase or by locally seting up PostgreSQL.
DATABASE_URL=postgres://sweety:sweety@localhost:5433/sweety
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=<-YOUR-JWT-SECRET-KEY->
JWT_EXPIRES_IN=7d
# Used to decide what "today" is when checking for future dates
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
